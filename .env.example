DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Include both the default runserver port and APP_PUBLISH_PORT. Development
# settings also merge http://localhost|127.0.0.1:{8000,APP_PUBLISH_PORT}.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

DB_NAME=railops
DB_USER=railops
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
# Host publish ports (change if 5432/8000 are already in use)
DB_PUBLISH_PORT=5432
APP_PUBLISH_PORT=8000

DEFAULT_FROM_EMAIL=webmaster@localhost
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

EXTERNAL_RAILWAY_API_URL=
EXTERNAL_RAILWAY_API_KEY=

MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
